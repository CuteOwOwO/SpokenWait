{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpokenWait trace v1",
  "type": "object",
  "required": ["schema_version", "task_id", "user_end_ms", "tool_stages", "speech_segments", "semantic_annotation"],
  "properties": {
    "schema_version": {"const": "spokenwait-trace-v1"},
    "task_id": {"type": "string"},
    "user_end_ms": {"type": "number"},
    "tool_stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_index", "tool_name", "call_ms", "result_ms"],
        "properties": {
          "step_index": {"type": "integer", "minimum": 1},
          "tool_name": {"type": "string"},
          "call_ms": {"type": "number"},
          "result_ms": {"type": "number"}
        }
      }
    },
    "speech_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start_ms", "end_ms", "text"],
        "properties": {
          "start_ms": {"type": "number"},
          "end_ms": {"type": "number"},
          "text": {"type": "string"}
        }
      }
    },
    "semantic_annotation": {
      "type": "object",
      "required": ["handoffs", "final_answer_start_ms"],
      "properties": {
        "handoffs": {"type": "array", "items": {"type": "object"}},
        "final_answer_start_ms": {"type": ["number", "null"]}
      }
    },
    "judge": {
      "type": "object",
      "properties": {
        "stage_hallucination": {"type": "array", "items": {"enum": [0, 1]}},
        "final_answer_correct": {"enum": [0, 1, null]}
      }
    }
  }
}
