    {
      "id": "appointment_service_1step_late_arrival_003",
      "category": "appointment_service",
      "step_count": 1,
      "user_prompt": "If I arrive at 3:28 PM for my physiotherapy appointment with Dr. Wang tomorrow, will I still be seen, and how many minutes would remain before it is automatically cancelled?",
      "input_reference_mode": "provider_and_relative_day",
      "first_stage_difficulty": "medium",
      "first_stage_input_rationale": "The user identifies the appointment with the clearly spoken public provider name Dr. Wang and a relative day. The arrival time remains a user fact; the tool supplies the scheduled time and policy thresholds.",
      "flow_summary": "查特定治療師的明日預約與遲到規則，由模型計算使用者遲到 8 分鐘、仍在寬限內，且距自動取消尚有 12 分鐘。",
      "tools": [
        {
          "name": "find_my_appointment",
          "description": "Find the signed-in user's appointment with a provider on a relative day. Returns provider_name (string), service_name (string), start_local (ISO local datetime string), grace_period_minutes (number), and auto_cancel_after_minutes (number). The two policy values are measured from the scheduled start time.",
          "parameters": {
            "provider_name": "string",
            "relative_day": "string"
          },
          "response": {
            "type": "object",
            "description": "Returned result.",
            "properties": {
              "provider_name": {
                "type": "string",
                "description": "Returned provider name."
              },
              "service_name": {
                "type": "string",
                "description": "Returned service name."
              },
              "start_local": {
                "type": "string",
                "description": "Returned start local."
              },
              "grace_period_minutes": {
                "type": "number",
                "description": "Returned grace period minutes."
              },
              "auto_cancel_after_minutes": {
                "type": "number",
                "description": "Returned auto cancel after minutes."
              }
            },
            "required": [
              "provider_name",
              "service_name",
              "start_local",
              "grace_period_minutes",
              "auto_cancel_after_minutes"
            ]
          }
        }
      ],
      "steps": [
        {
          "index": 1,
          "label": "appointment_policy",
          "tool_name": "find_my_appointment",
          "tool_input": {
            "provider_name": "Dr. Wang",
            "relative_day": "tomorrow"
          },
          "mocked_result": {
            "provider_name": "Dr. Wang",
            "service_name": "physiotherapy",
            "start_local": "2026-09-08T15:20:00+08:00",
            "grace_period_minutes": 10,
            "auto_cancel_after_minutes": 20
          },
          "waiting_speech_target": "正在查看 Dr. Wang 明天的預約時間與遲到規則。"
        }
      ],
      "expected_final_answer": "會。15:28 抵達是遲到 8 分鐘，仍在 10 分鐘寬限內；距離預約開始滿 20 分鐘而自動取消，還有 12 分鐘。"
    },
