    {
      "id": "appointment_service_1step_family_details_001",
      "category": "appointment_service",
      "step_count": 1,
      "user_prompt": "Mia needs to leave the clinic by 11:30 AM. Will her appointment tomorrow finish in time, and how much time would she have left?",
      "input_reference_mode": "person_and_relative_day",
      "first_stage_difficulty": "low",
      "first_stage_input_rationale": "The user supplies an ordinary person's name and a relative day. The 11:30 deadline stays in the user request and is not encoded as a hidden lookup argument.",
      "flow_summary": "依人名與明日條件查家庭成員預約的開始時間與工時，再計算能否在 11:30 前完成及剩餘時間。",
      "tools": [
        {
          "name": "find_family_appointment",
          "description": "Find an appointment belonging to a person on the signed-in user's family account for a relative day. Returns guest_name (string), service_name (string), start_local (ISO local datetime string), duration_minutes (number), branch_name (string), and status (string). It does not calculate a finish time or compare it with a deadline.",
          "parameters": {
            "guest_name": "string",
            "relative_day": "string"
          },
          "response": {
            "type": "object",
            "description": "Returned result.",
            "properties": {
              "guest_name": {
                "type": "string",
                "description": "Returned guest name."
              },
              "service_name": {
                "type": "string",
                "description": "Returned service name."
              },
              "start_local": {
                "type": "string",
                "description": "Returned start local."
              },
              "duration_minutes": {
                "type": "number",
                "description": "Returned duration minutes."
              },
              "branch_name": {
                "type": "string",
                "description": "Returned branch name."
              },
              "status": {
                "type": "string",
                "description": "Returned status."
              }
            },
            "required": [
              "guest_name",
              "service_name",
              "start_local",
              "duration_minutes",
              "branch_name",
              "status"
            ]
          }
        }
      ],
      "steps": [
        {
          "index": 1,
          "label": "appointment",
          "tool_name": "find_family_appointment",
          "tool_input": {
            "guest_name": "Mia",
            "relative_day": "tomorrow"
          },
          "mocked_result": {
            "guest_name": "Mia",
            "service_name": "eye exam",
            "start_local": "2026-09-08T10:40:00+08:00",
            "duration_minutes": 35,
            "branch_name": "Riverside Clinic",
            "status": "confirmed"
          },
          "waiting_speech_target": "正在查看 Mia 明天的預約時間與預計時長。"
        }
      ],
      "expected_final_answer": "可以。Mia 的預約 10:40 開始，預計 35 分鐘，會在 11:15 完成，距離 11:30 還有 15 分鐘。"
    },
