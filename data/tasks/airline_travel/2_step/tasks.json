            "type": "object",
            "description": "Returned result.",
            "properties": {
              "flight_number": {
                "type": "string",
                "description": "Returned flight number."
              },
              "service_date": {
                "type": "string",
                "description": "Returned service date."
              },
              "origin": {
                "type": "string",
                "description": "Returned origin."
              },
              "destination": {
                "type": "string",
                "description": "Returned destination."
              },
              "scheduled_departure_local": {
                "type": "string",
                "description": "Returned scheduled departure local."
              }
            },
            "required": [
              "flight_number",
              "service_date",
              "origin",
              "destination",
              "scheduled_departure_local"
            ]
          }
        },
        {
          "name": "get_flight_operation",
          "description": "Retrieve the current operating record for one flight on one service date. Returns operating_status (string), departure_terminal (string), gate (string), and boarding_local (ISO local datetime string).",
