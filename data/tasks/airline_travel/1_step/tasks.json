      "tools": [
        {
          "name": "find_my_flight",
          "description": "Find the signed-in user's flight matching a destination and relative day. Returns flight_number (string), service_date (YYYY-MM-DD string), departure_terminal (string), gate (string), boarding_local (ISO local datetime string), and operating_status (string).",
