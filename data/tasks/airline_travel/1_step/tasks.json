    {
      "id": "airline_travel_1step_baggage_fee_003",
      "category": "airline_travel",
      "step_count": 1,
      "user_prompt": "On my flight tomorrow, I will check two bags weighing 23 and 29 kilograms. How much will I pay in total?",
      "input_reference_mode": "temporal_query",
      "first_stage_difficulty": "low",
      "first_stage_input_rationale": "The account-scoped tool resolves the signed-in user's next flight without requiring a redundant date selector; bag count and weights are user facts used only after the policy is returned.",
      "flow_summary": "查明日行程適用的行李規則，依兩件行李重量計算總費用。",
      "tools": [
        {
          "name": "get_next_flight_checked_baggage_policy",
          "description": "Retrieve the checked-baggage policy for the signed-in user's next flight. Returns baggage_plan (string), currency (string), standard_weight_limit_kg (number), maximum_accepted_weight_kg (number), bag_base_fees (array of bag_number and fee records), and overweight_fee_per_bag (number). It does not calculate a total charge. This account-scoped tool takes no arguments.",
          "parameters": {},
          "response": {
            "type": "object",
            "description": "Returned result.",
            "properties": {
              "baggage_plan": {
                "type": "string",
                "description": "Returned baggage plan."
              },
              "currency": {
                "type": "string",
                "description": "Returned currency."
              },
              "standard_weight_limit_kg": {
                "type": "number",
                "description": "Returned standard weight limit kg."
              },
              "maximum_accepted_weight_kg": {
                "type": "number",
                "description": "Returned maximum accepted weight kg."
              },
              "bag_base_fees": {
                "type": "array",
                "description": "Returned bag base fees.",
                "items": {
                  "type": "object",
                  "description": "Returned item.",
                  "properties": {
                    "bag_number": {
                      "type": "number",
                      "description": "Returned bag number."
                    },
                    "fee": {
                      "type": "number",
                      "description": "Returned fee."
                    }
                  },
                  "required": [
                    "bag_number",
                    "fee"
                  ]
                }
              },
              "overweight_fee_per_bag": {
                "type": "number",
                "description": "Returned overweight fee per bag."
              }
            },
            "required": [
              "baggage_plan",
              "currency",
              "standard_weight_limit_kg",
              "maximum_accepted_weight_kg",
              "bag_base_fees",
              "overweight_fee_per_bag"
            ]
          }
        }
      ],
      "steps": [
        {
          "index": 1,
          "label": "baggage_policy",
          "tool_name": "get_next_flight_checked_baggage_policy",
          "tool_input": {},
          "mocked_result": {
            "baggage_plan": "Standard International",
            "currency": "USD",
            "standard_weight_limit_kg": 23,
            "maximum_accepted_weight_kg": 32,
            "bag_base_fees": [
              {
                "bag_number": 1,
                "fee": 0
              },
              {
                "bag_number": 2,
                "fee": 45
              }
            ],
            "overweight_fee_per_bag": 75
          },
          "waiting_speech_target": "正在查你明日行程適用的托運行李規則。"
        }
      ],
      "expected_final_answer": "總共 120 美元：第二件基本費 45 美元，加上 29 公斤行李的超重費 75 美元。"
    },
    {
      "id": "airline_travel_1step_timezone_arrival_004",
      "category": "airline_travel",
      "step_count": 1,
      "user_prompt": "What local time will my flight to Tokyo arrive tomorrow?",
      "input_reference_mode": "temporal_query",
      "first_stage_difficulty": "low",
      "first_stage_input_rationale": "The user states a destination and relative day. The tool supplies all date-specific time-zone facts, so no city-time-zone knowledge is assumed.",
      "flow_summary": "查航班的出發當地時間、飛行時間與兩地 offset，再計算目的地當地抵達時間。",
      "tools": [
        {
          "name": "get_my_flight_time_details",
          "description": "Retrieve timing facts for the signed-in user's flight. Returns origin (string), destination (string), departure_local_date (YYYY-MM-DD string), departure_local_time (HH:MM string), duration_minutes (number), origin_utc_offset (UTC offset string), and destination_utc_offset (UTC offset string). It does not return the arrival time.",
          "parameters": {
            "destination": "string",
            "relative_day": "string"
          },
          "response": {
            "type": "object",
            "description": "Returned result.",
            "properties": {
              "origin": {
                "type": "string",
                "description": "Returned origin."
              },
              "destination": {
                "type": "string",
                "description": "Returned destination."
              },
              "departure_local_date": {
                "type": "string",
                "description": "Returned departure local date."
              },
              "departure_local_time": {
                "type": "string",
                "description": "Returned departure local time."
              },
              "duration_minutes": {
                "type": "number",
                "description": "Returned duration minutes."
              },
              "origin_utc_offset": {
                "type": "string",
                "description": "Returned origin utc offset."
              },
              "destination_utc_offset": {
                "type": "string",
                "description": "Returned destination utc offset."
              }
            },
            "required": [
              "origin",
              "destination",
              "departure_local_date",
              "departure_local_time",
              "duration_minutes",
              "origin_utc_offset",
              "destination_utc_offset"
            ]
          }
        }
