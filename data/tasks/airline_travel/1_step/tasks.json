            "departure_local_date": "2026-09-08",
            "departure_local_time": "09:30",
            "duration_minutes": 240,
            "origin_utc_offset": "+08:00",
            "destination_utc_offset": "+09:00"
          },
          "waiting_speech_target": "正在查你明天前往 Tokyo 的航班時間資料。"
        }
      ],
      "expected_final_answer": "你會在 Tokyo 當地時間 14:30 抵達。"
    },
