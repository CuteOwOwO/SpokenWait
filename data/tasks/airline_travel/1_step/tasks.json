    {
      "id": "airline_travel_1step_budget_arrival_001",
      "category": "airline_travel",
      "step_count": 1,
      "user_prompt": "I need to fly from Taipei to Osaka tomorrow, arrive by 3 PM, and spend no more than 220 U.S. dollars including taxes. Which flight works?",
      "input_reference_mode": "temporal_query",
      "first_stage_difficulty": "medium",
      "first_stage_input_rationale": "The only tool argument is the relative day stated by the user. Route, deadline, and budget remain user-side constraints that must be applied to returned raw flight records.",
      "flow_summary": "查明日航班清單，再依使用者給的路線、抵達期限與含稅預算找唯一符合者。",
      "tools": [
        {
          "name": "search_daily_flights",
          "description": "Retrieve a small daily flight schedule. Returns flights, each with flight_number (string), origin (string), destination (string), departure_local (ISO local datetime string), arrival_local (ISO local datetime string), total_price_including_taxes (number), and currency (string). It does not select or recommend a flight.",
          "parameters": {
            "relative_day": "string"
          },
          "response": {
            "type": "object",
            "description": "Returned result.",
            "properties": {
              "flights": {
                "type": "array",
                "description": "Returned flights.",
                "items": {
                  "type": "object",
                  "description": "Returned item.",
                  "properties": {
                    "flight_number": {
                      "type": "string",
                      "description": "Returned flight number."
                    },
                    "origin": {
                      "type": "string",
                      "description": "Returned origin."
                    },
                    "destination": {
                      "type": "string",
                      "description": "Returned destination."
                    },
                    "departure_local": {
                      "type": "string",
                      "description": "Returned departure local."
                    },
                    "arrival_local": {
                      "type": "string",
                      "description": "Returned arrival local."
                    },
                    "total_price_including_taxes": {
                      "type": "number",
                      "description": "Returned total price including taxes."
                    },
                    "currency": {
                      "type": "string",
                      "description": "Returned currency."
                    }
                  },
                  "required": [
                    "flight_number",
                    "origin",
                    "destination",
                    "departure_local",
                    "arrival_local",
                    "total_price_including_taxes",
                    "currency"
                  ]
                }
              }
            },
            "required": [
              "flights"
            ]
          }
        }
      ],
      "steps": [
        {
          "index": 1,
          "label": "daily_schedule",
          "tool_name": "search_daily_flights",
          "tool_input": {
            "relative_day": "tomorrow"
          },
          "mocked_result": {
            "flights": [
              {
                "flight_number": "AW214",
                "origin": "Taipei",
                "destination": "Osaka",
                "departure_local": "2026-09-08T09:10:00+08:00",
                "arrival_local": "2026-09-08T13:05:00+09:00",
                "total_price_including_taxes": 245,
                "currency": "USD"
              },
              {
                "flight_number": "AW216",
                "origin": "Taipei",
                "destination": "Osaka",
                "departure_local": "2026-09-08T11:35:00+08:00",
                "arrival_local": "2026-09-08T15:35:00+09:00",
                "total_price_including_taxes": 198,
                "currency": "USD"
              },
              {
                "flight_number": "AW218",
                "origin": "Taipei",
                "destination": "Osaka",
                "departure_local": "2026-09-08T10:40:00+08:00",
                "arrival_local": "2026-09-08T14:40:00+09:00",
                "total_price_including_taxes": 215,
                "currency": "USD"
              },
              {
                "flight_number": "AW220",
                "origin": "Taipei",
                "destination": "Tokyo",
                "departure_local": "2026-09-08T09:45:00+08:00",
                "arrival_local": "2026-09-08T13:50:00+09:00",
                "total_price_including_taxes": 205,
                "currency": "USD"
              }
            ]
          },
          "waiting_speech_target": "正在查看明天的航班與含稅價格。"
        }
      ],
      "expected_final_answer": "AW218 符合：從 Taipei 飛往 Osaka，14:40 抵達，含稅 215 美元。"
    },
    {
      "id": "airline_travel_1step_gate_context_002",
      "category": "airline_travel",
      "step_count": 1,
      "user_prompt": "Which gate is my flight to Osaka using tomorrow?",
      "input_reference_mode": "temporal_query",
      "first_stage_difficulty": "low",
