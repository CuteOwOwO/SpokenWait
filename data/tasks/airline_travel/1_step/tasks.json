            "required": [
              "flight_number",
              "service_date",
              "departure_terminal",
              "gate",
              "boarding_local",
              "operating_status"
            ]
          }
        }
      ],
      "steps": [
        {
          "index": 1,
          "label": "flight",
          "tool_name": "find_my_flight",
          "tool_input": {
            "destination": "Osaka",
            "relative_day": "tomorrow"
          },
          "mocked_result": {
