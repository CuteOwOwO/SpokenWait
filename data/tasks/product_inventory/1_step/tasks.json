      "first_stage_difficulty": "high",
      "first_stage_input_rationale": "The natural material-and-color phrase sand linen selects the relevant clearance lots; the tool result, rather than the user, states that each lot is sold as one complete bundle.",
      "future_hooks": {
        "solution_process": {
