                "Daan",
                "Songshan",
                "Banqiao"
              ]
            }
          },
          "response": {
            "type": "object",
            "description": "Returned result.",
            "properties": {
              "boxes": {
                "type": "array",
                "description": "Returned boxes.",
                "items": {
                  "type": "object",
                  "description": "Returned item.",
                  "properties": {
                    "box_name": {
                      "type": "string",
                      "description": "Returned box name."
                    },
                    "inner_length_cm": {
                      "type": "integer",
                      "description": "Returned inner length cm."
                    },
                    "inner_width_cm": {
                      "type": "integer",
                      "description": "Returned inner width cm."
                    },
                    "inner_height_cm": {
                      "type": "integer",
                      "description": "Returned inner height cm."
                    },
                    "on_hand": {
                      "type": "integer",
                      "description": "Returned on hand."
                    },
                    "reserved": {
                      "type": "integer",
                      "description": "Returned reserved."
                    }
                  },
                  "required": [
                    "box_name",
                    "inner_length_cm",
                    "inner_width_cm",
                    "inner_height_cm",
                    "on_hand",
                    "reserved"
                  ]
                }
              }
            },
            "required": [
              "boxes"
            ]
          }
        }
      ],
      "steps": [
        {
          "index": 1,
          "label": "box_inventory",
          "tool_name": "list_shipping_box_inventory",
          "tool_input": {
            "branch_name": "Zhongshan"
          },
          "mocked_result": {
            "boxes": [
              {
                "box_name": "Slim",
                "inner_length_cm": 70,
                "inner_width_cm": 48,
                "inner_height_cm": 18,
                "on_hand": 3,
                "reserved": 0
              },
              {
                "box_name": "Wide",
                "inner_length_cm": 72,
                "inner_width_cm": 54,
                "inner_height_cm": 15,
                "on_hand": 2,
                "reserved": 1
              },
              {
                "box_name": "Square",
                "inner_length_cm": 70,
                "inner_width_cm": 52,
                "inner_height_cm": 52,
                "on_hand": 1,
                "reserved": 0
              },
              {
                "box_name": "Long",
                "inner_length_cm": 80,
                "inner_width_cm": 46,
                "inner_height_cm": 20,
                "on_hand": 4,
                "reserved": 0
              }
            ]
          },
          "waiting_speech_target": "正在查看中山分店各款包裝箱的內部尺寸與可售庫存。",
          "case_insensitive_arguments": [
            "branch_name"
          ],
          "argument_aliases": {
            "branch_name": [
              "Zhongshan branch",
              "Jongshan",
              "Jong Shan",
              "Chungshan",
              "Chung Shan",
              "Jhongshan",
              "Jhong Shan"
            ]
          }
        }
      ],
      "expected_final_answer": "Choose the Wide box. With padding, the print needs 68 by 50 by 13 centimeters. Slim and Long each have one side that is too short even after rotation. Wide and Square fit and are sellable, but Wide has the smaller inner volume.",
      "input_reference_mode": "natural_entity",
      "first_stage_difficulty": "medium",
      "first_stage_input_rationale": "The model-visible five-branch enum supplies canonical spellings; the backend also accepts bounded phonetic aliases for Zhongshan.",
      "future_hooks": {
        "solution_process": {
          "summary": "先擴張物品尺寸，再用九十度旋轉做三邊匹配，最後才在可售合格箱中比較體積。",
          "steps": [
            "每面3公分緩衝使三個維度各增加6，需求為68×50×13公分。",
            "Slim的48公分邊不足、Long的46公分邊不足；三邊排序後仍無法配對。",
