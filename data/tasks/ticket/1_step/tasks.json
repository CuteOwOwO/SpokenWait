    {
      "id": "ticket_1step_resale_net_002",
      "category": "ticket",
      "step_count": 1,
      "user_prompt": "I want to list my two Adele tickets for 2,800 dollars each. If they sell, how much would I actually receive, and would that be a profit or a loss compared with what I originally paid?",
      "flow_summary": "用歌手名稱找到登入帳戶中的兩張票，並把使用者想掛的每張2800元帶入轉售服務；模型先套最高合法刊登價，再扣賣方費用並與原訂單完整成本比較。",
      "tools": [
        {
          "name": "get_my_ticket_resale_inputs",
          "description": "Return the signed-in user's tickets for the named performer, the submitted asking price, original payment components, and raw marketplace cap and seller-fee rules. It does not calculate the effective listing price, payout, or profit and loss.",
          "parameters": {
            "performer_name": {
              "type": "string",
              "description": "The performer name spoken by the user."
            },
            "asking_price_per_ticket_twd": {
              "type": "integer",
              "description": "The user's desired listing price for each ticket in TWD.",
              "minimum": 1
            }
          },
          "response": {
            "type": "object",
            "description": "Returned result.",
            "properties": {
              "performer_name": {
                "type": "string",
                "description": "Returned performer name."
              },
              "currency": {
                "type": "string",
                "description": "Returned currency."
              },
              "ticket_count": {
                "type": "integer",
                "description": "Returned ticket count."
              },
              "submitted_asking_price_per_ticket_twd": {
                "type": "integer",
                "description": "Returned submitted asking price per ticket twd."
              },
              "original_order": {
                "type": "object",
                "description": "Returned original order.",
                "properties": {
                  "face_value_per_ticket_twd": {
                    "type": "integer",
                    "description": "Returned face value per ticket twd."
                  },
                  "facility_fee_per_ticket_twd": {
                    "type": "integer",
                    "description": "Returned facility fee per ticket twd."
                  },
                  "delivery_fee_per_order_twd": {
                    "type": "integer",
                    "description": "Returned delivery fee per order twd."
                  }
                },
                "required": [
                  "face_value_per_ticket_twd",
                  "facility_fee_per_ticket_twd",
                  "delivery_fee_per_order_twd"
                ]
              },
              "resale_rules": {
                "type": "object",
                "description": "Returned resale rules.",
                "properties": {
                  "maximum_listing_multiplier_of_face_value": {
                    "type": "number",
                    "description": "Returned maximum listing multiplier of face value."
                  },
                  "over_cap_treatment": {
                    "type": "string",
                    "description": "Returned over cap treatment."
                  },
                  "seller_fee_percent_of_effective_sale_price": {
                    "type": "integer",
                    "description": "Returned seller fee percent of effective sale price."
                  },
                  "original_facility_and_delivery_fees_recoverable_from_buyer": {
                    "type": "boolean",
                    "description": "Returned original facility and delivery fees recoverable from buyer."
                  }
                },
                "required": [
                  "maximum_listing_multiplier_of_face_value",
                  "over_cap_treatment",
                  "seller_fee_percent_of_effective_sale_price",
                  "original_facility_and_delivery_fees_recoverable_from_buyer"
                ]
              }
            },
            "required": [
              "performer_name",
              "currency",
              "ticket_count",
              "submitted_asking_price_per_ticket_twd",
              "original_order",
              "resale_rules"
            ]
          }
        }
      ],
      "steps": [
        {
          "index": 1,
          "label": "ticket_facts",
          "tool_name": "get_my_ticket_resale_inputs",
          "tool_input": {
            "performer_name": "Adele",
            "asking_price_per_ticket_twd": 2800
          },
          "mocked_result": {
            "performer_name": "Adele",
            "currency": "TWD",
            "ticket_count": 2,
            "submitted_asking_price_per_ticket_twd": 2800,
            "original_order": {
              "face_value_per_ticket_twd": 2000,
              "facility_fee_per_ticket_twd": 150,
              "delivery_fee_per_order_twd": 100
            },
            "resale_rules": {
              "maximum_listing_multiplier_of_face_value": 1.2,
              "over_cap_treatment": "If the submitted asking price exceeds the cap, the marketplace lists the ticket at the highest legal price.",
              "seller_fee_percent_of_effective_sale_price": 15,
              "original_facility_and_delivery_fees_recoverable_from_buyer": false
            }
          },
          "waiting_speech_target": "正在查看你帳戶裡 Adele 票券的原始成本、刊登上限與賣方費用。",
          "case_insensitive_arguments": [
            "performer_name"
          ]
        }
      ],
      "expected_final_answer": "Your 2,800 TWD asking price is capped at 2,400 TWD per ticket. After the 15% seller fee, you receive 2,040 TWD per ticket, or 4,080 TWD total. You originally paid 4,400 TWD including the two facility fees and the order delivery fee, so this is a 320 TWD loss.",
      "input_reference_mode": "natural_entity",
      "first_stage_difficulty": "high",
      "first_stage_input_rationale": "Adele is a short, well-known performer name; 2,800 is not decorative—it is the user's proposed price that must first be tested against the marketplace cap.",
      "future_hooks": {
        "solution_process": {
          "summary": "2800元是使用者真的想掛的價格；不能直接拿它抽成，必須先壓到票面價120%的上限，再比較淨實收與原始完整成本。",
          "steps": [
            "每張票面價2000元，合法上限為2000×1.2＝2400元，所以2800元會被平台壓成2400元。",
            "賣方費15%，每張實收2400×0.85＝2040元；兩張共4080元。",
            "原實付為2000×2＋150×2＋100＝4400元，因此不是獲利，而是虧320元。"
          ]
        },
        "tool_io_examples": [
          {
            "step": 1,
            "tool_name": "get_my_ticket_resale_inputs",
            "input_example_zh": "用 performer_name=Adele、asking_price_per_ticket_twd=2800 查登入者的對應票與轉售規則。",
            "output_example_zh": "回傳兩張票、每張票面 2,000、場館費 150、每單配送費 100、最高 120% 與 15% 賣方費；不直接算實收。"
          }
        ]
      }
    },
    {
      "id": "ticket_1step_relocation_compensation_003",
      "category": "ticket",
      "step_count": 1,
      "user_prompt": "For my September 12 matinee, the organizer moved our three seats from section A to section C. One of the three tickets is a student ticket. Under the seat-change notice, how much compensation should we receive in total?",
      "flow_summary": "用場次日期與自然的通知主題查該場次對應內容；服務只回座位更換通知、逐張淨票價與補償矩陣，模型選A到C分支並逐張計算。",
      "tools": [
        {
          "name": "get_my_performance_change_notice",
          "description": "Return only the requested notice topic for the signed-in user's performance on a date. Supported topics are seat relocation, schedule change, and venue change. For a seat-relocation request it returns original and replacement sections, per-ticket net prices, excluded fees, and the raw compensation matrix, but no compensation total.",
          "parameters": {
            "event_date": {
              "type": "string",
              "description": "The local performance date stated by the user, in YYYY-MM-DD format.",
              "format": "date"
            },
            "notice_topic": {
              "type": "string",
              "description": "Which part of the organizer notice to retrieve.",
              "enum": [
                "seat relocation",
                "schedule change",
                "venue change"
              ]
            }
          },
          "response": {
            "type": "object",
            "description": "Returned result.",
            "properties": {
              "returned_notice_topic": {
                "type": "string",
                "description": "Returned returned notice topic."
              },
              "performance": {
                "type": "string",
                "description": "Returned performance."
              },
              "original_section": {
                "type": "string",
                "description": "Returned original section."
              },
              "replacement_section": {
                "type": "string",
                "description": "Returned replacement section."
              },
              "tickets": {
                "type": "array",
                "description": "Returned tickets.",
                "items": {
                  "type": "object",
                  "description": "Returned item.",
                  "properties": {
                    "ticket_type": {
                      "type": "string",
                      "description": "Returned ticket type."
                    },
                    "net_ticket_price_twd": {
                      "type": "integer",
                      "description": "Returned net ticket price twd."
                    },
                    "facility_fee_twd": {
                      "type": "integer",
                      "description": "Returned facility fee twd."
                    }
                  },
                  "required": [
                    "ticket_type",
                    "net_ticket_price_twd",
                    "facility_fee_twd"
                  ]
                }
              },
              "compensation_matrix": {
                "type": "array",
                "description": "Returned compensation matrix.",
                "items": {
                  "type": "object",
                  "description": "Returned item.",
                  "properties": {
                    "relocation": {
                      "type": "string",
                      "description": "Returned relocation."
                    },
                    "percent_of_each_ticket_net_price": {
                      "type": "integer",
                      "description": "Returned percent of each ticket net price."
                    }
                  },
                  "required": [
                    "relocation",
                    "percent_of_each_ticket_net_price"
                  ]
                }
              },
              "calculation_rules": {
                "type": "array",
                "description": "Returned calculation rules.",
                "items": {
                  "type": "string",
                  "description": "Returned item."
                }
              }
            },
            "required": [
              "returned_notice_topic",
              "performance",
              "original_section",
              "replacement_section",
              "tickets",
              "compensation_matrix",
              "calculation_rules"
            ]
          }
        }
      ],
      "steps": [
        {
          "index": 1,
          "label": "ticket_facts",
          "tool_name": "get_my_performance_change_notice",
          "tool_input": {
            "event_date": "2026-09-12",
            "notice_topic": "seat relocation"
          },
          "mocked_result": {
            "returned_notice_topic": "seat relocation",
            "performance": "September 12 matinee",
            "original_section": "A",
            "replacement_section": "C",
            "tickets": [
              {
                "ticket_type": "regular",
                "net_ticket_price_twd": 1500,
                "facility_fee_twd": 100
              },
              {
                "ticket_type": "regular",
                "net_ticket_price_twd": 1500,
                "facility_fee_twd": 100
              },
              {
                "ticket_type": "student",
                "net_ticket_price_twd": 1200,
                "facility_fee_twd": 100
              }
            ],
            "compensation_matrix": [
              {
                "relocation": "A to B",
                "percent_of_each_ticket_net_price": 10
              },
              {
                "relocation": "A to C",
                "percent_of_each_ticket_net_price": 25
              },
              {
                "relocation": "B to C",
                "percent_of_each_ticket_net_price": 12
              }
            ],
            "calculation_rules": [
              "Apply the matching percentage separately to each ticket's actual net ticket price.",
              "Discounted tickets use their own net ticket price.",
              "Facility fees are excluded from compensation."
            ]
          },
          "waiting_speech_target": "正在讀取九月十二日下午場的座位更換通知與補償矩陣。",
          "case_insensitive_arguments": [
            "notice_topic"
          ]
        }
      ],
      "expected_final_answer": "The A-to-C rate is 25%. The two regular tickets receive 375 TWD each and the student ticket receives 300 TWD, for 1,050 TWD total. The facility fees are excluded.",
      "input_reference_mode": "natural_entity",
      "first_stage_difficulty": "high",
      "first_stage_input_rationale": "The date is speech-stable, while notice_topic is a small public service enum derived directly from the user's request; it selects a real section of a multi-topic organizer notice.",
      "future_hooks": {
        "solution_process": {
          "summary": "第二個參數不再是假change type，而是使用者要讀取的通知章節；這一呼叫只取得seat relocation內容，再由模型從矩陣選分支。",
          "steps": [
            "原A區改到C區，使用補償矩陣的A to C＝25%。",
            "兩張一般票各1500×25%＝375元；學生票按自己的1200元算，為300元。",
            "場館費排除，因此總補償375＋375＋300＝1050元。"
          ]
        },
        "tool_io_examples": [
          {
            "step": 1,
            "tool_name": "get_my_performance_change_notice",
            "input_example_zh": "查 2026-09-12 場次通知中的 seat relocation 主題。",
            "output_example_zh": "只回傳 A 區改 C 區、三張票各自淨票價、場館費與完整換區補償矩陣，不混入改期或換場館資料。"
          }
        ]
      }
    },
