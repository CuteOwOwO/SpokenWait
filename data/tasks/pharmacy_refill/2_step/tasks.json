    {
      "id": "pharmacy_2step_supply_then_coverage_window",
      "category": "pharmacy_refill",
      "step_count": 2,
      "user_prompt": "For the monthly refill I filled on September 1, if I keep following the label exactly, on what date will my insurance first cover the next fill, and how many tablets will I have left at the start of that day?",
      "flow_summary": "先查目前藥量與具語意的給付方案欄位，再查該方案適用的原始百分比規則，計算最早給付日期與當日剩餘量。",
      "tools": [
        {
          "name": "get_prescription_supply_for_fill_date",
          "description": "Return the signed-in user's monthly refill filled on the requested local date, including quantity, printed daily use, recorded days supply, named coverage plan, and coverage class. It does not calculate a depletion or refill date.",
          "parameters": {
            "fill_date": {
              "type": "string",
              "description": "The local calendar date on which the refill was filled, in YYYY-MM-DD format.",
              "format": "date"
            }
          },
          "response": {
            "type": "object",
            "description": "Returned result.",
            "properties": {
              "fill_start_date": {
                "type": "string",
                "description": "Returned fill start date."
              },
              "quantity_dispensed": {
                "type": "number",
                "description": "Returned quantity dispensed."
              },
              "units_per_day": {
                "type": "number",
                "description": "Returned units per day."
              },
              "dose_times_local": {
                "type": "array",
                "description": "Returned dose times local.",
                "items": {
                  "type": "string",
                  "description": "Returned item."
                }
              },
              "recorded_days_supply": {
                "type": "number",
                "description": "Returned recorded days supply."
              },
              "coverage_plan": {
                "type": "string",
                "description": "Returned coverage plan."
              },
              "coverage_class": {
                "type": "string",
                "description": "Returned coverage class."
              }
            },
            "required": [
              "fill_start_date",
              "quantity_dispensed",
              "units_per_day",
              "dose_times_local",
              "recorded_days_supply",
              "coverage_plan",
              "coverage_class"
            ]
          }
        },
        {
          "name": "get_refill_timing_policy",
          "description": "Return the raw refill-timing threshold and boundary rule for a named coverage plan and medication coverage class. It does not calculate the member's eligibility date.",
          "parameters": {
            "coverage_plan": {
              "type": "string",
              "description": "The human-readable coverage plan name returned by the current prescription supply service."
            },
            "coverage_class": {
              "type": "string",
              "description": "The semantic medication coverage class returned by the current prescription supply service."
            }
          },
          "response": {
            "type": "object",
            "description": "Returned result.",
            "properties": {
              "eligible_after_percent_consumed": {
                "type": "number",
                "description": "Returned eligible after percent consumed."
              },
              "threshold_application": {
                "type": "string",
                "description": "Returned threshold application."
              },
              "eligibility_starts": {
                "type": "string",
                "description": "Returned eligibility starts."
              }
            },
            "required": [
              "eligible_after_percent_consumed",
              "threshold_application",
              "eligibility_starts"
            ]
          }
        }
      ],
      "steps": [
        {
          "index": 1,
          "label": "current_supply",
          "tool_name": "get_prescription_supply_for_fill_date",
          "tool_input": {
            "fill_date": "2026-09-01"
          },
          "mocked_result": {
            "fill_start_date": "2026-09-01",
            "quantity_dispensed": 48,
            "units_per_day": 2,
            "dose_times_local": [
              "morning",
              "evening"
            ],
            "recorded_days_supply": 24,
            "coverage_plan": "Everyday Plus",
            "coverage_class": "maintenance"
          },
          "waiting_speech_target": "正在查看目前處方的供應量與給付方案。"
        },
        {
          "index": 2,
          "label": "timing_policy",
          "tool_name": "get_refill_timing_policy",
          "tool_input": {
            "coverage_plan": "Everyday Plus",
            "coverage_class": "maintenance"
          },
          "mocked_result": {
            "eligible_after_percent_consumed": 75,
            "threshold_application": "after_complete_calendar_days",
            "eligibility_starts": "start_of_next_local_day"
          },
          "waiting_speech_target": "正在查看這個方案適用的續領時間規則。",
          "input_dependencies": [
            {
              "step_index": 1,
              "result_field": "coverage_plan",
              "argument_name": "coverage_plan"
            },
            {
              "step_index": 1,
              "result_field": "coverage_class",
              "argument_name": "coverage_class"
            }
          ]
        }
      ],
      "expected_final_answer": "Insurance first covers the next fill on September 19. At the start of that day, 12 tablets remain.",
      "input_reference_mode": "temporal_query",
      "first_stage_difficulty": "medium",
      "first_stage_input_rationale": "The explicit September 1 fill date selects the refill record. Step 2 receives only stable, human-readable business fields returned by Step 1, never a prescription identifier.",
      "future_hooks": {
        "solution_process": {
          "summary": "第一步找這張處方屬於哪種給付方案；第二步才查得到該方案的續領門檻。",
          "steps": [
            "Step 1 用使用者說的 9 月 1 日作為 fill_date，回傳 48 顆、每天 2 顆、共 24 天，以及 Everyday Plus／maintenance。",
            "Step 2 必須原樣傳入 Everyday Plus 與 maintenance，得到『用完 75% 的完整日數後，次日本地日開始可領』。",
            "24 天的 75% 剛好是 18 天，不需要進位。9 月 1–18 日共吃掉 18 × 2 = 36 顆，9 月 19 日開始符合給付。",
            "9 月 19 日一開始尚未吃當天的藥，所以剩 48 − 36 = 12 顆。"
          ]
        }
      }
    },
