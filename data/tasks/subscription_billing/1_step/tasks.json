    {
      "id": "subscription_billing_1step_payment_ledger_001",
      "category": "subscription_billing",
      "step_count": 1,
      "user_prompt": "I see several 390-dollar entries around my September subscription renewal. After every pending entry and reversal has finished settling, did I end up paying for the renewal more than once, and what net amount remained charged?",
      "flow_summary": "取得九月續訂前後的原始付款事件與事件語意；模型排除失效預授權，將請款和沖銷配對後重建有效扣款次數與淨入帳金額。",
      "tools": [
        {
          "name": "get_my_subscription_payment_ledger",
          "description": "Return all payment-ledger events around the signed-in user's subscription renewal for a billing month, together with the accounting effect of each event type. It does not determine whether the user was effectively charged more than once, count effective charges, or calculate the net settled amount.",
          "parameters": {
            "billing_month": {
              "type": "string",
              "description": "The local subscription billing month stated by the user, in YYYY-MM format.",
              "pattern": "^\\d{4}-\\d{2}$"
            }
          },
          "response": {
            "type": "object",
            "description": "Returned result.",
            "properties": {
              "currency": {
                "type": "string",
                "description": "Returned currency."
              },
              "renewal_description": {
                "type": "string",
                "description": "Returned renewal description."
              },
              "ledger_events": {
                "type": "array",
                "description": "Returned ledger events.",
                "items": {
                  "type": "object",
                  "description": "Returned item.",
                  "properties": {
                    "occurred_at": {
                      "type": "string",
                      "description": "Returned occurred at."
                    },
                    "entry_label": {
                      "type": "string",
                      "description": "Returned entry label."
                    },
                    "statement_description": {
                      "type": "string",
                      "description": "Returned statement description."
                    },
                    "event_type": {
                      "type": "string",
                      "description": "Returned event type."
                    },
                    "status": {
                      "type": "string",
                      "description": "Returned status."
                    },
                    "amount_twd": {
                      "type": "integer",
                      "description": "Returned amount twd."
                    },
                    "related_entry_label": {
                      "type": "string",
                      "description": "Returned related entry label."
                    }
                  },
                  "required": [
                    "occurred_at",
                    "entry_label",
                    "statement_description",
                    "event_type",
                    "status",
                    "amount_twd",
                    "related_entry_label"
                  ]
                }
              },
              "ledger_semantics": {
                "type": "object",
                "description": "Returned ledger semantics.",
                "properties": {
                  "authorization": {
                    "type": "string",
                    "description": "Returned authorization."
                  },
                  "capture": {
                    "type": "string",
                    "description": "Returned capture."
                  },
                  "reversal": {
                    "type": "string",
                    "description": "Returned reversal."
                  }
                },
                "required": [
                  "authorization",
                  "capture",
                  "reversal"
                ]
              }
            },
            "required": [
              "currency",
              "renewal_description",
              "ledger_events",
              "ledger_semantics"
            ]
          }
        }
      ],
      "steps": [
        {
          "index": 1,
          "label": "subscription_billing_facts",
          "tool_name": "get_my_subscription_payment_ledger",
          "tool_input": {
            "billing_month": "2026-09"
          },
          "mocked_result": {
            "currency": "TWD",
            "renewal_description": "September Pro subscription renewal",
            "ledger_events": [
              {
                "occurred_at": "2026-09-01T08:58:00+08:00",
                "entry_label": "temporary card authorization",
                "statement_description": "Pro renewal pending authorization",
                "event_type": "authorization",
                "status": "expired",
                "amount_twd": 390,
                "related_entry_label": "none"
              },
              {
                "occurred_at": "2026-09-01T09:01:00+08:00",
                "entry_label": "first renewal capture",
                "statement_description": "Pro renewal payment",
                "event_type": "capture",
                "status": "settled",
                "amount_twd": 390,
                "related_entry_label": "none"
              },
              {
                "occurred_at": "2026-09-01T09:02:00+08:00",
                "entry_label": "duplicate renewal capture",
                "statement_description": "Pro renewal payment duplicate",
                "event_type": "capture",
                "status": "settled",
                "amount_twd": 390,
                "related_entry_label": "none"
              },
              {
                "occurred_at": "2026-09-02T10:00:00+08:00",
                "entry_label": "duplicate-capture reversal",
                "statement_description": "Reversal of duplicate Pro renewal payment",
                "event_type": "reversal",
                "status": "settled",
                "amount_twd": 390,
                "related_entry_label": "duplicate renewal capture"
              }
            ],
            "ledger_semantics": {
              "authorization": "An authorization does not change the settled balance; an expired authorization contributes zero.",
              "capture": "A settled capture adds its amount to the settled balance.",
              "reversal": "A settled reversal subtracts its amount and neutralizes the related settled capture."
            }
          },
          "waiting_speech_target": "正在核對九月續訂前後的預授權、請款與沖銷紀錄。"
        }
      ],
      "expected_final_answer": "No, there is only one effective charge. The expired 390 TWD authorization contributes zero. The two settled captures add 780 TWD, but the settled 390 TWD reversal neutralizes the duplicate capture, leaving a net settled amount of 390 TWD.",
      "input_reference_mode": "natural_account_query",
      "first_stage_difficulty": "high",
      "first_stage_input_rationale": "The billing month is a natural statement from the user; all private ledger entries are retrieved from the signed-in account without a transaction ID.",
      "future_hooks": {
        "solution_process": {
          "summary": "不能數畫面上有幾筆390元；必須按事件類型與狀態重建settled balance，並將沖銷和對應請款配對。",
          "steps": [
            "Expired authorization不影響實際入帳，先排除390元。",
            "兩筆settled capture合計780元；settled reversal沖回duplicate capture的390元。",
            "淨入帳為390元，且第二筆請款已被完整中和，因此只有一次有效扣款。"
          ]
        },
        "tool_io_examples": [
          {
            "step": 1,
            "tool_name": "get_my_subscription_payment_ledger",
            "input_example_zh": "查我九月訂閱續訂前後所有 390 元的付款紀錄。",
            "output_example_zh": "依時間回傳四筆 390 元：9/1 08:58 已失效預授權、09:01 正常請款、09:02 重複請款，以及 9/2 10:00 明確指向重複請款的沖銷；另說明各事件如何影響實際入帳。"
          }
        ]
      }
    },
