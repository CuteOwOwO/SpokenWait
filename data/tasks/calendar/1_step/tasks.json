      "id": "calendar_1step_meeting_type_buffers",
      "category": "calendar",
      "step_count": 1,
      "user_prompt": "On September 9, between 1 and 5 PM, find the earliest uninterrupted 75 minutes for me to write a report. Leave 15 minutes before and after client meetings, 10 minutes after internal syncs, and no buffer for one-on-ones. Do not start later than 3:30 PM. When can I work?",
      "flow_summary": "Retrieve raw typed events, apply the user-stated buffers, and select the earliest valid 75-minute interval.",
      "tools": [
        {
          "name": "get_day_calendar",
          "description": "Return time_zone and confirmed events with title, meeting_type, start_local, end_local, and status within the requested local-time window.",
