            "event_date": {
              "type": "string",
              "description": "The local calendar date in YYYY-MM-DD format.",
              "format": "date"
            },
            "time_start": {
              "type": "string",
              "description": "The inclusive local lower time bound in HH:MM format.",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "time_end": {
              "type": "string",
              "description": "The exclusive local upper time bound in HH:MM format.",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          },
          "response": {
            "type": "object",
            "properties": {
              "time_zone": {
                "type": "string"
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "meeting_type": {
                      "type": "string"
                    },
                    "start_local": {
                      "type": "string"
                    },
                    "end_local": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "title",
                    "meeting_type",
                    "start_local",
                    "end_local",
                    "status"
                  ]
                }
              }
            },
            "required": [
              "time_zone",
              "events"
            ]
          }
        }
      ],
      "steps": [
