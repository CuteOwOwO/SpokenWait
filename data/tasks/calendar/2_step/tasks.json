    {
      "id": "calendar_2step_meeting_type_buffer_rules",
      "category": "calendar",
      "step_count": 2,
      "user_prompt": "On September 9, between 1 and 5 PM, use the applicable buffer rules for each kind of meeting to find the earliest uninterrupted 75 minutes for me to write a report. Do not start later than 3:30 PM.",
