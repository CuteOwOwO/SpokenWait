            "event_date": {
              "type": "string",
              "description": "The local calendar date in YYYY-MM-DD format.",
              "format": "date"
            },
            "time_start": {
              "type": "string",
              "description": "The local lower bound in HH:MM format.",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "time_end": {
              "type": "string",
              "description": "The local upper bound in HH:MM format.",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          },
          "response": {
            "type": "object",
            "properties": {
              "time_zone": {
                "type": "string"
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
