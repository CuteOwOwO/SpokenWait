              "maximum_requests_per_order": 1,
              "deadline_is_inclusive": true,
              "eligible_offer_types": [
                "regular sale"
              ],
              "excluded_offer_types": [
                "clearance"
              ],
              "maximum_adjustment_per_unit": 400,
              "calculation_rule": "A single request covers all requested items that are eligible on its submission date. For each eligible unit, use the price active on that date and refund the smaller of the paid-to-active price difference and the per-unit maximum. An item submitted after its deadline or under an excluded offer type receives no adjustment."
            }
          },
          "waiting_speech_target": "正在查看九月一日訂單兩項商品今天與明天的價格和退價差期限。",
          "case_insensitive_arguments": [
            "item_names"
          ],
          "order_insensitive_arguments": [
            "item_names"
          ]
        }
      ],
      "expected_final_answer": "Requesting today yields 350 TWD for the headphones and zero for the phone cases, totaling 350 TWD. Waiting until tomorrow makes the headphones one day late, while the two phone cases yield 300 TWD, totaling 300 TWD. Because the order permits only one request, submit today; it pays 50 TWD more.",
      "input_reference_mode": "temporal_query",
      "first_stage_difficulty": "high",
      "first_stage_input_rationale": "The user explicitly supplies the order date and the complete item-name list. The service does not require an order or line-item ID.",
      "future_hooks": {
        "solution_process": {
          "summary": "分別建立今天與明天的申請情境；每個情境都要檢查品項截止日、當日價格、數量與單件上限，最後在一次申請限制下比較。",
          "steps": [
            "今天9月7日申請：耳機尚在含當日的截止期限內，退2,400減2,050等於350元；手機殼今天未降價，所以合計350元。",
            "明天9月8日申請：耳機已超過9月7日截止日，退0元；兩個手機殼各退600減450等於150元，合計300元。",
            "每張訂單只能申請一次，不能把兩天的金額合併；今天申請350元，比明天300元多50元。"
          ]
        }
      }
    },
