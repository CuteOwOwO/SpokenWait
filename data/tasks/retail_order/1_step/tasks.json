            "prices_include_tax": true,
            "current_date": "2026-09-07",
            "following_date": "2026-09-08",
            "order_lines": [
              {
                "item_name": "headphones",
                "quantity": 1,
                "price_paid_per_unit": 2400,
                "price_on_current_date_per_unit": 2050,
                "offer_type_on_current_date": "regular sale",
                "price_on_following_date_per_unit": 2050,
                "offer_type_on_following_date": "regular sale",
                "adjustment_request_deadline": "2026-09-07"
              },
              {
                "item_name": "phone case",
                "quantity": 2,
                "price_paid_per_unit": 600,
                "price_on_current_date_per_unit": 600,
                "offer_type_on_current_date": "regular price",
                "price_on_following_date_per_unit": 450,
                "offer_type_on_following_date": "regular sale",
                "adjustment_request_deadline": "2026-09-10"
              }
            ],
